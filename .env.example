# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Airtable personal access token (airtable.com/create/tokens)
# Scopes: data.records:read, data.records:write. Access: only the "Job Search Tracker" base.
AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxxxx

AIRTABLE_BASE_ID=appfZkhr2AnDVkuiD
AIRTABLE_TABLE_ID=tblKHpUH7X7azesgP

# The password you'll type to open the app
APP_PASSWORD=choose-a-long-password

# Random string, 32+ characters, used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
